        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "linesBottomUp": {
          "type": "array",
          "items": {
            "enum": [
              0,
              1
            ]
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "id",
        "name",
        "image",
        "symbol",
        "linesBottomUp"
      ],
      "additionalProperties": false
    },
    "lowerTrigram": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "qian",
            "kun",
            "zhen",
            "kan",
            "gen",
            "xun",
            "li",
            "dui"
