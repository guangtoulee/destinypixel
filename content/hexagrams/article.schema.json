  "title": "DestinyPixel complete hexagram learning article v2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^hexagram-(0[1-9]|[1-5][0-9]|6[0-4])$"
    },
    "locale": {
      "enum": [
        "en",
        "zh",
        "zh-TW",
        "ru"
      ]
    },
    "kingWenNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
